# Copy these into Vercel → Project → Settings → Environment Variables
# (all three are REQUIRED before /admin will work)

# 1. The password you type at /admin
ADMIN_PASSWORD=change-me

# 2. Random string used to sign session tokens (any long random text)
#    Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-too

# 3. GitHub token with write access to the portfolio repo
#    GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
#    Repository: katrate/portfolio  |  Permissions: Contents: Read and write
GITHUB_TOKEN=ghp_change_me

# Optional overrides (defaults shown)
CONTENT_REPO=katrate/portfolio
CONTENT_BRANCH=main
